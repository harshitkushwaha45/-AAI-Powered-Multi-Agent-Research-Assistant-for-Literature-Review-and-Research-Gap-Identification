{
  "name": "researchmind-server",
  "version": "1.0.0",
  "description": "ResearchMind API - multi-agent research assistant backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/**/*.test.js",
    "evaluate": "node src/scripts/runEvaluation.js",
    "create-vector-index": "node src/scripts/createVectorIndex.js"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@huggingface/transformers": "^4.2.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.3",
    "morgan": "^1.10.0",
    "neo4j-driver": "^6.2.0",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  }
}
